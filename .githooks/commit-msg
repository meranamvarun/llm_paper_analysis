#!/bin/sh
# Ensure every commit names the primary researcher.
f="$1"
if ! grep -q '^Primary-Researcher: TO CONFIRM$' "$f"; then
  git interpret-trailers --in-place --trailer 'Primary-Researcher=TO CONFIRM' --where start --if-exists doNothing "$f" 2>/dev/null
  grep -q '^Primary-Researcher: TO CONFIRM$' "$f" || printf '\nPrimary-Researcher: TO CONFIRM\n' >> "$f"
fi
