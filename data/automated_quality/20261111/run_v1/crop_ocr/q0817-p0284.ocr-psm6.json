        18.0,
        412.5,
        29.1
      ]
    },
    {
      "line_id": "l0002",
      "text": "b) They not imagining a perfectly ordered society.",
      "bbox": [
        72.0,
        30.599999999999998,
        338.4,
        44.099999999999994
      ]
    },
    {
      "line_id": "l0003",
      "text": "were",
