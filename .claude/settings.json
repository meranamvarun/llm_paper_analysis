{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/harness/bin/hook.sh\" session-start claude-code",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/harness/bin/hook.sh\" stop claude-code",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
